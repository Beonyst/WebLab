@using WebLab.Controllers

@{
    var reviews = ViewData["Reviews"] as List<Review> ?? new List<Review>();
}

<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Мастер и Маргарита | Библиотекарь</title>

    <link rel="stylesheet" href="/styles.css">
</head>

<body>

    <header class="header">

        <nav class="nav container">

            <a href="/index.html" class="logo">
                Библиотекарь
            </a>

            <ul class="nav-links">

                <li>
                    <a href="/index.html">
                        Главная
                    </a>
                </li>

                <li>
                    <a href="/catalog.html">
                        Каталог
                    </a>
                </li>

                <li>
                    <a href="/add.html">
                        Добавить книгу
                    </a>
                </li>

            </ul>

        </nav>

    </header>


    <main class="container">

        <section class="book-detail">

            <div class="book-detail-grid">

                <div class="book-detail-cover">

                    <div class="book-cover-large"
                         style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">

                        <span class="book-cover-placeholder">
                            Мастер и Маргарита
                        </span>

                    </div>

                </div>


                <div class="book-detail-info">

                    <h1 class="book-detail-title">
                        Мастер и Маргарита
                    </h1>

                    <p class="book-detail-author">
                        Михаил Булгаков
                    </p>

                    <p class="book-detail-genre">
                        Фантастика, Классика, Мистика
                    </p>


                    <div class="book-detail-rating">

                        <span class="star-large">★</span>
                        <span class="star-large">★</span>
                        <span class="star-large">★</span>
                        <span class="star-large">★</span>
                        <span class="star-large">★</span>

                        <span class="rating-text">
                            (5.0 из 5)
                        </span>

                    </div>


                    <p class="book-detail-year">
                        Год издания: 1967
                    </p>

                    <p class="book-detail-pages">
                        Страниц: 480
                    </p>


                    <div class="book-detail-description">

                        <h2>
                            Описание
                        </h2>

                        <p>
                            «Мастер и Маргарита» — роман Михаила Булгакова,
                            над которым он работал с конца 1920-х годов до своей смерти.
                            Это философское произведение, сочетающее в себе элементы
                            мистики, сатиры и любовной истории.
                        </p>

                        <p>
                            Действие романа разворачивается в Москве 1930-х годов,
                            куда прибывает дьявол со своей свитой. Параллельно
                            развивается история любви Мастера и Маргариты,
                            а также рассказ о Понтии Пилате и Иешуа Га-Ноцри.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <section class="reviews-section">

            <h2 class="reviews-title">
                Отзывы читателей
            </h2>


            @if (reviews.Count > 0)
            {
                foreach (var review in reviews)
                {
                    <div class="review-card">

                        <div class="review-header">

                            <div class="reviewer-avatar">
                                @(string.IsNullOrEmpty(review.Name)
                                    ? "?"
                                    : review.Name.Substring(0, 1).ToUpper())
                            </div>


                            <div class="reviewer-info">

                                <p class="reviewer-name">
                                    @review.Name
                                </p>

                            </div>


                            <span class="review-date">
                                @review.Date
                            </span>

                        </div>


                        <p class="review-text">
                            @review.Text
                        </p>

                    </div>
                }
            }
            else
            {
                <div class="review-card">

                    <p class="review-text">
                        Отзывов пока нет. Будьте первым, кто оставит отзыв.
                    </p>

                </div>
            }


            <div class="add-review-placeholder">

                <h3>
                    Оставьте свой отзыв
                </h3>

                <p>
                    Поделитесь своим мнением о книге.
                </p>


                <form method="post"
                      action="/book"
                      class="book-form review-form">


                    <div class="form-group">

                        <label for="name">
                            Ваше имя
                        </label>

                        <input type="text"
                               id="name"
                               name="name"
                               maxlength="100"
                               required
                               placeholder="Введите ваше имя">

                    </div>


                    <div class="form-group">

                        <label for="text">
                            Ваш отзыв
                        </label>

                        <textarea id="text"
                                  name="text"
                                  maxlength="2000"
                                  required
                                  placeholder="Напишите ваш отзыв"></textarea>

                    </div>


                    <div class="form-actions">

                        <button type="submit"
                                class="btn btn-primary">

                            Отправить отзыв

                        </button>

                    </div>

                </form>

            </div>

        </section>

    </main>


    <footer class="footer">

        <div class="container">

            <p>
                © 2026 Личный книжный дневник - лабораторная работа по web.
            </p>

        </div>

    </footer>

</body>

</html>