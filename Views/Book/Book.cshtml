@using WebLab.Models
@{
    var book = ViewData["Book"] as Book ?? new Book();
    var reviews = ViewData["Reviews"] as List<Review> ?? new List<Review>();

    var avg = reviews.Count > 0
        ? reviews.Average(r => r.Rating ?? 0)
        : 0;
    var fullStars = (int)Math.Round(avg, MidpointRounding.AwayFromZero);
}

<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@book.Title | Библиотекарь</title>

    <link rel="stylesheet" href="/styles.css">
</head>

<body>

    <header class="header">

        <nav class="nav container">

            <a href="/index.html" class="logo">
                Библиотекарь
            </a>

            <ul class="nav-links">

                <li>
                    <a href="/index.html">
                        Главная
                    </a>
                </li>

                <li>
                    <a href="/catalog">
                        Каталог
                    </a>
                </li>

                <li>
                    <a href="/add">
                        Добавить книгу
                    </a>
                </li>

            </ul>

        </nav>

    </header>


    <main class="container">

        <section class="book-detail">

            <div class="book-detail-grid">

                <div class="book-detail-cover">

                    @if (!string.IsNullOrEmpty(book.CoverUrl))
                    {
                        <img src="@book.CoverUrl"
                             alt="Обложка книги «@book.Title»"
                             class="real-book-cover book-cover-large">
                    }

                </div>


                <div class="book-detail-info">

                    <h1 class="book-detail-title">
                        @book.Title
                    </h1>

                    <p class="book-detail-author">
                        @book.Author
                    </p>

                    <p class="book-detail-genre">
                        @book.Genre
                    </p>


                    <div class="book-detail-rating">

                        @for (var i = 0; i < 5; i++)
                        {
                            <span class="star-large">@(i < fullStars ? "★" : "☆")</span>
                        }

                        <span class="rating-text">
                            (@avg.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) из 5)
                        </span>

                    </div>

                </div>

            </div>

        </section>


        <section class="reviews-section">

            <h2 class="reviews-title">
                Отзывы читателей (@reviews.Count)
            </h2>


            @if (reviews.Count > 0)
            {
                foreach (var review in reviews)
                {
                    <div class="review-card">

                        <div class="review-header">

                            <div class="reviewer-avatar">
                                @(string.IsNullOrEmpty(review.Username)
                                    ? "?"
                                    : review.Username.Substring(0, 1).ToUpper())
                            </div>


                            <div class="reviewer-info">

                                <p class="reviewer-name">
                                    @review.Username
                                </p>

                                @if (review.Rating.HasValue)
                                {
                                    var stars = new string('★', review.Rating.Value) + new string('☆', 5 - review.Rating.Value);
                                    <p class="reviewer-rating">
                                        @stars
                                    </p>
                                }

                            </div>


                            <span class="review-date">
                                @review.Date
                            </span>

                        </div>


                        <p class="review-text">
                            @review.Text
                        </p>

                    </div>
                }
            }
            else
            {
                <div class="review-card">

                    <p class="review-text">
                        Отзывов пока нет. Будьте первым, кто оставит отзыв.
                    </p>

                </div>
            }


            <div class="add-review-placeholder">

                <h3>
                    Оставьте свой отзыв
                </h3>

                <p>
                    Поделитесь своим мнением о книге.
                </p>


                <form method="post"
                      action="/book/@book.Id"
                      class="book-form review-form">


                    <div class="form-group">

                        <label for="name">
                            Ваше имя
                        </label>

                        <input type="text"
                               id="name"
                               name="name"
                               maxlength="100"
                               required
                               placeholder="Введите ваше имя">

                    </div>


                    <div class="form-group">

                        <label for="rating">
                            Оценка
                        </label>

                        <select id="rating" name="rating">
                            <option value="">Без оценки</option>
                            <option value="5">★★★★★ (5)</option>
                            <option value="4">★★★★☆ (4)</option>
                            <option value="3">★★★☆☆ (3)</option>
                            <option value="2">★★☆☆☆ (2)</option>
                            <option value="1">★☆☆☆☆ (1)</option>
                        </select>

                    </div>


                    <div class="form-group">

                        <label for="text">
                            Ваш отзыв
                        </label>

                        <textarea id="text"
                                  name="text"
                                  maxlength="2000"
                                  required
                                  placeholder="Напишите ваш отзыв"></textarea>

                    </div>


                    <div class="form-actions">

                        <button type="submit"
                                class="btn btn-primary">

                            Отправить отзыв

                        </button>

                    </div>

                </form>

            </div>

        </section>

    </main>


    <footer class="footer">

        <div class="container">

            <p>
                © 2026 Личный книжный дневник - лабораторная работа по web.
            </p>

        </div>

    </footer>

</body>

</html>
